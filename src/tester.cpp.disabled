#include "webserver.hpp"
#include "HTTPRequest.hpp"
#include "HTTPResponse.hpp"
#include "types.hpp"

// --------------------------------------------------------------------------
// Minimal test harness
// --------------------------------------------------------------------------
static int s_passed = 0;
static int s_failed = 0;

#define ASSERT(cond, msg)                                                       \
    do {                                                                        \
        if (cond) {                                                             \
            std::cout << "  [PASS] " << msg << "\n";                           \
            ++s_passed;                                                         \
        } else {                                                                \
            std::cout << "  [FAIL] " << msg << "\n";                           \
            ++s_failed;                                                         \
        }                                                                       \
    } while (0)

static void print_section(const std::string& name)
{
    std::cout << "\n==== " << name << " ====\n";
}

// --------------------------------------------------------------------------
// HTTPRequest tests
// --------------------------------------------------------------------------
static void test_request_basic_get()
{
    print_section("HTTPRequest - basic GET");
    HTTPRequest req;

    std::string raw =
        "GET /index.html HTTP/1.1\r\n"
        "Host: localhost\r\n"
        "Connection: keep-alive\r\n"
        "\r\n";

    bool complete = req.parse(raw);

    ASSERT(complete,                            "parse() returns true on complete request");
    ASSERT(req.isComplete(),                    "isComplete() is true");
    ASSERT(req.getMethod()  == "GET",           "method is GET");
    ASSERT(req.getUri()     == "/index.html",   "URI is /index.html");
    ASSERT(req.getPath()    == "/index.html",   "path is /index.html");
    ASSERT(req.getQuery()   == "",              "query is empty");
    ASSERT(req.getVersion() == "HTTP/1.1",      "version is HTTP/1.1");
    ASSERT(req.hasHeader("host"),               "Host header present");
    ASSERT(req.getHeader("host") == "localhost","Host header value correct");
    ASSERT(req.getBody()    == "",              "body is empty");
    ASSERT(req.getState()   == PS_COMPLETE,     "parse state is PS_COMPLETE");
}

static void test_request_query_string()
{
    print_section("HTTPRequest - query string");
    HTTPRequest req;

    std::string raw =
        "GET /search?q=hello&page=2 HTTP/1.1\r\n"
        "Host: localhost\r\n"
        "\r\n";

    req.parse(raw);

    ASSERT(req.getPath()  == "/search",         "path stripped of query");
    ASSERT(req.getQuery() == "q=hello&page=2",  "query string extracted");
}

static void test_request_post_with_body()
{
    print_section("HTTPRequest - POST with body");
    HTTPRequest req;

    std::string body    = "username=alice&password=secret";
    std::string raw =
        "POST /login HTTP/1.1\r\n"
        "Host: localhost\r\n"
        "Content-Type: application/x-www-form-urlencoded\r\n"
        "Content-Length: 30\r\n"
        "\r\n" + body;

    bool complete = req.parse(raw);

    ASSERT(complete,                                    "parse() returns true");
    ASSERT(req.getMethod()          == "POST",          "method is POST");
    ASSERT(req.getPath()            == "/login",        "path is /login");
    ASSERT(req.getContentLength()   == 30,              "Content-Length is 30");
    ASSERT(req.getBody()            == body,            "body matches");
}

static void test_request_incremental_feed()
{
    print_section("HTTPRequest - incremental feed");
    HTTPRequest req;

    // First chunk: only the request line
    std::string chunk1 = "DELETE /resource/42 HTTP/1.1\r\n";
    bool done = req.parse(chunk1);
    ASSERT(!done, "not complete after first chunk");

    // Second chunk: headers + blank line — parse() has no internal buffer,
    // so pass the full accumulated raw string each time.
    std::string chunk2 = "Host: localhost\r\n\r\n";
    done = req.parse(chunk1 + chunk2);
    ASSERT(done,                              "complete after second chunk");
    ASSERT(req.getMethod() == "DELETE",       "method is DELETE");
    ASSERT(req.getUri()    == "/resource/42", "URI correct");
}

static void test_request_reset()
{
    print_section("HTTPRequest - reset");
    HTTPRequest req;

    std::string raw =
        "GET / HTTP/1.1\r\n"
        "Host: localhost\r\n"
        "\r\n";
    req.parse(raw);
    ASSERT(req.isComplete(), "complete before reset");

    req.reset();
    ASSERT(!req.isComplete(),                  "not complete after reset");
    ASSERT(req.getMethod() == "",              "method cleared");
    ASSERT(req.getBody()   == "",              "body cleared");
    ASSERT(req.getState()  == PS_REQUEST_LINE, "state reset to PS_REQUEST_LINE");
}

static void test_request_invalid()
{
    print_section("HTTPRequest - malformed input");
    HTTPRequest req;

    // No HTTP version on request line
    std::string raw = "GET /bad\r\nHost: localhost\r\n\r\n";
    req.parse(raw);
    ASSERT(req.getState() == PS_ERROR, "malformed request line sets PS_ERROR");
}

// --------------------------------------------------------------------------
// HTTPResponse tests
// --------------------------------------------------------------------------
static void test_response_200()
{
    print_section("HTTPResponse - 200 OK");
    HTTPResponse res;

    res.setStatus(200);
    res.setBody("<h1>Hello</h1>", "text/html");

    ASSERT(res.getStatusCode()   == 200,             "status code is 200");
    ASSERT(res.getReasonPhrase() == "OK",            "reason phrase is OK");
    ASSERT(res.getBody()         == "<h1>Hello</h1>","body set correctly");

    std::string raw = res.serialize();
    ASSERT(raw.find("HTTP/1.1 200 OK")         != std::string::npos, "status line present");
    ASSERT(raw.find("Content-Type: text/html") != std::string::npos, "Content-Type header present");
    ASSERT(raw.find("<h1>Hello</h1>")          != std::string::npos, "body present in serialized output");
}

static void test_response_404()
{
    print_section("HTTPResponse - 404 Not Found");
    HTTPResponse res;

    res.setStatus(404);
    res.setBody("Not Found");

    ASSERT(res.getStatusCode()   == 404,          "status code is 404");
    ASSERT(res.getReasonPhrase() == "Not Found",  "default reason phrase");

    std::string raw = res.serialize();
    ASSERT(raw.find("HTTP/1.1 404 Not Found") != std::string::npos, "404 status line present");
}

static void test_response_custom_headers()
{
    print_section("HTTPResponse - custom headers");
    HTTPResponse res;

    res.setStatus(301, "Moved Permanently");
    res.setHeader("Location", "/new-path");
    res.setHeader("X-Custom", "value");

    std::string raw = res.serialize();
    ASSERT(raw.find("301 Moved Permanently") != std::string::npos, "custom reason phrase");
    ASSERT(raw.find("Location: /new-path")   != std::string::npos, "Location header present");
    ASSERT(raw.find("X-Custom: value")       != std::string::npos, "custom header present");
}

static void test_response_content_length()
{
    print_section("HTTPResponse - Content-Length in serialize");
    HTTPResponse res;

    res.setStatus(200);
    res.setBody("Hello, World!");  // 13 bytes

    std::string raw = res.serialize();
    ASSERT(raw.find("Content-Length: 13") != std::string::npos, "Content-Length header correct");
}

static void test_response_reset()
{
    print_section("HTTPResponse - reset");
    HTTPResponse res;

    res.setStatus(500);
    res.setBody("error");
    res.reset();

    ASSERT(res.getStatusCode() == 200, "status reset to default (200)");
    ASSERT(res.getBody()        == "",  "body cleared");
}

static void test_response_empty_body()
{
    print_section("HTTPResponse - empty body (204 No Content)");
    HTTPResponse res;

    res.setStatus(204, "No Content");
    std::string raw = res.serialize();

    ASSERT(raw.find("204 No Content") != std::string::npos, "204 status line present");
    size_t sep = raw.find("\r\n\r\n");
    ASSERT(sep != std::string::npos,   "header/body separator present");
    ASSERT(raw.substr(sep + 4) == "",  "no body after separator");
}

static void test_response_header_overwrite()
{
    print_section("HTTPResponse - header overwrite");
    HTTPResponse res;

    res.setHeader("X-Test", "one");
    res.setHeader("X-Test", "two");

    std::string raw = res.serialize();
    ASSERT(raw.find("X-Test: two") != std::string::npos, "header value overwritten");
    ASSERT(raw.find("X-Test: one") == std::string::npos, "old header value removed");
}

static void test_response_default_reason_405()
{
    print_section("HTTPResponse - default reason 405");
    HTTPResponse res;

    res.setStatus(405);

    ASSERT(res.getReasonPhrase() == "Method Not Allowed", "default reason phrase for 405");
    ASSERT(res.serialize().find("405 Method Not Allowed") != std::string::npos, "serialized 405 status line");
}

// --------------------------------------------------------------------------
// Entry point
// --------------------------------------------------------------------------

int main()
{
    // HTTPRequest
    test_request_basic_get();
    test_request_query_string();
    test_request_post_with_body();
    test_request_incremental_feed();
    test_request_reset();
    test_request_invalid();

    // HTTPResponse
    test_response_200();
    test_response_404();
    test_response_custom_headers();
    test_response_content_length();
    test_response_reset();
    test_response_empty_body();
    test_response_header_overwrite();
    test_response_default_reason_405();

    // Summary
    std::cout << "\n----------------------------------------\n";
    std::cout << "Results: " << s_passed << " passed, " << s_failed << " failed\n";
    return 0;
}
